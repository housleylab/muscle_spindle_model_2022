create node[1],myelin[1],term,preterm
objref myllist,nodelist
myllist=new SectionList()
nodelist=new SectionList()
NNODES=5

proc topol() {local i
	nnodes = $1
	create node[nnodes], myelin[nnodes]
	access node[0]
	for i=0, nnodes-2 {
		connect myelin[i](0), node[i](1)
		connect node[i+1](0), myelin[i](1)
		myelin[i]  myllist.append()
		node[i]  nodelist.append()
	}
		connect myelin[nnodes-1](0),node[nnodes-1](1)
		myelin[nnodes-1] myllist.append()
		node[nnodes-1] nodelist.append()
}

topol(NNODES)

forall {insert pas Ra=100 e_pas=-80}
v_init=-80


term{
L=100
diam=3
g_pas=0.0001
nseg=5
insert MRCHas
}
xopen("make_stretch.hoc")


L0=-6
DELAY=40
RDUR1=150
SLOPE1=.02
RDUR2=150
SLOPE2=-0.02
TPLAT=1000

new_ramp()
mycmd.play(&rmL_MRCHas,dt)
mydL.play(&rmdL_MRCHas,dt)

tstop=1400

access node[0]
connect preterm(1),node[0](0)
connect term(1),preterm(0)

forsec nodelist{L=3 diam=3 g_pas=0.0001}
forsec myllist{L=500 nseg=20 g_pas=2e-6 cm=0.005 diam=5}

celsius=37


xopen("test_params_Haskm.hoc")  //uses km instead of KCNQ
// uses Hasan spindle model

//run
//run()
//plotrate("Z.txt")
