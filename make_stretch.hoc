/* make_stretch.hoc   sets up a trapezoidal waveform for use as a command potential   assumes the following are known:   dt		time step*/// Easy mnemonics so I can set these in the interpreter// and then invoke simple() (just in case I forget the calling// syntax for mkramp(), or maybe only want to change one param).// My convention for constants is upper caseL0 = 0	// starting lengthSLOPE1 = 0.015	// normalized length change/msRDUR1 = 20	//ms duration of rising rampSLOPE2 = -0.015	// normalized length change/msRDUR2 = 20	//ms duration of falling rampDELAY = 10	// ms  time until first rampTPLAT = 160	//ms duration of hold phaseobjref mycmd,mycmd1,mycmd2,mycmd3,mycmd4,mydLmycmd = new Vector()	// must create object outside procmycmd1 = new Vector()	// must create object outside procmycmd2 = new Vector()	// must create object outside procmycmd3 = new Vector()	// must create object outside procmycmd4 = new Vector()	// must create object outside procmydL = new Vector()/* Creates a "ramp" vector arguments:   $1	l0	command at start of ramp	(mV)   $2	slope	dv/dt during ramp			(mV/ms)   $3	rdur	duration of ramp			(ms)   $4	delay	duration of ramp			(ms)   $5	tplat	duration of plateau			(ms) */// I double the initial letter so these local variables won't // collide with global names that I may want to use laterproc mktrap() { local ii, vv0, sslope, ttr, vv1	ll0 = $1	sslope1 = $2	rrdur1 = $3	sslope2 = $4	rrdur2 = $5     	ddelay= $6	ttplat = $7	ll1 = ll0 + sslope1*rrdur1	mycmd1.indgen(ll0, ll1, dt*sslope1)	mycmd3.indgen(ll1,ll0,dt*sslope2)// mycmd3.reverse() mycmd.resize(ddelay/dt) mycmd.fill(ll0) mycmd4.resize(ddelay/dt) mycmd4.fill(ll0) mycmd2.resize(ttplat/dt) mycmd2.fill(ll1) mycmd.append(mycmd1,mycmd2,mycmd3,mycmd4) //now make vector that has rate of change of length mydL.resize(ddelay/dt) mydL.fill(0) mycmd1.fill(sslope1) mycmd2.fill(0) mycmd3.fill(sslope2) mycmd4.fill(0) mydL.append(mycmd1,mycmd2,mycmd3,mycmd4) }// I can invoke mkbiramp() with all 7 arguments,// or I can change a single "constant" // and then invoke simple() with no arguments.proc new_ramp() {	mktrap(L0,SLOPE1,RDUR1,SLOPE2,RDUR2,DELAY,TPLAT)}